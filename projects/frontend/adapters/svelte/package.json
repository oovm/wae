{
    "name": "@wae/adapter-svelte",
    "version": "0.1.0",
    "description": "把 @wae/client 注入 Svelte（context/stores adapter）；不重实现响应式",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/client": "workspace:*"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "peerDependenciesMeta": {
        "svelte": {
            "optional": false
        }
    },
    "devDependencies": {
        "typescript": "catalog:",
        "svelte": "^5.0.0"
    }
}
