{
    "name": "@wae/adapter-solid",
    "version": "0.1.0",
    "description": "把 @wae/client 注入 Solid（context / resource helpers）；不重实现 signals",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/client": "workspace:*"
    },
    "peerDependencies": {
        "solid-js": "^1.9.0"
    },
    "peerDependenciesMeta": {
        "solid-js": {
            "optional": false
        }
    },
    "devDependencies": {
        "typescript": "catalog:",
        "solid-js": "^1.9.0"
    }
}
