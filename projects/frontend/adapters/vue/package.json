{
    "name": "@wae/adapter-vue",
    "version": "0.1.0",
    "description": "把 @wae/client 注入 Vue（provide/useWae/composables）；不提供 Vue 组件库",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/client": "workspace:*"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": false
        }
    },
    "devDependencies": {
        "typescript": "catalog:",
        "vue": "^3.5.0"
    }
}
