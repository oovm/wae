{
    "name": "@wae/adapter-vue",
    "version": "0.0.0",
    "description": "把 @wae/client 注入 Vue（provide/useWae/composables）；不提供 Vue 组件库",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/client": "workspace:*"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "peerDependenciesMeta": {
        "vue": {
            "optional": false
        }
    },
    "devDependencies": {
        "typescript": "catalog:",
        "vue": "^3.5.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    }
}
