{
    "name": "@wae/client",
    "version": "0.1.0",
    "description": "框架无关的 TypeScript 应用运行时（生命周期 / server / RPC / bridge / session；无 JSX/组件/hooks）",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/types": "workspace:*",
        "@wae/core": "workspace:*",
        "@wae/protocol": "workspace:*"
    },
    "devDependencies": {
        "typescript": "catalog:"
    }
}
