{
    "name": "@wae/wae-android-arm64",
    "version": "0.0.0",
    "description": "Android arm64 native host",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "lib"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json",
        "build:native": "node ../../../scripts/build-platform-native.mjs"
    },
    "license": "MIT",
    "wae": {
        "platform": "android-arm64"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    },
    "cpu": [
        "arm64"
    ],
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@wae/types": "workspace:*"
    }
}
