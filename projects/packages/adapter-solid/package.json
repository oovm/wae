{
    "name": "@wae/adapter-solid",
    "version": "0.0.0",
    "description": "把 @wae/client 注入 Solid（context / resource helpers）；不重实现 signals",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/client": "workspace:*"
    },
    "peerDependencies": {
        "solid-js": "^1.9.0"
    },
    "peerDependenciesMeta": {
        "solid-js": {
            "optional": false
        }
    },
    "devDependencies": {
        "typescript": "catalog:",
        "solid-js": "^1.9.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    }
}
