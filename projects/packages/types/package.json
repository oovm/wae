{
    "name": "@wae/types",
    "version": "0.0.0",
    "description": "WAE 协议 TypeScript 类型（由 communication/schema codegen；无 runtime）",
    "type": "module",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "check": "tsc -p tsconfig.json --noEmit",
        "build": "tsc -p tsconfig.json",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "typescript": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    },
    "main": "./dist/index.js"
}
