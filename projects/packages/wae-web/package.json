{
    "name": "@wae/wae-web",
    "version": "0.0.0",
    "description": "纯浏览器适配（Browser APIs；不加载 Rust/WASM）",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "license": "MIT",
    "wae": {
        "platform": "web"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "typescript": "catalog:"
    }
}
