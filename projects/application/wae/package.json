{
    "name": "@wae/wae",
    "version": "0.1.0",
    "description": "WAE 工程 CLI（Node/TypeScript；取代 Rust wae-cli）",
    "type": "module",
    "bin": {
        "wae": "./bin/wae.mjs"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "bin",
        "dist",
        "src",
        "templates"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit"
    },
    "peerDependencies": {
        "vite": "^7.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "license": "MIT"
}
