{
    "name": "@wae/server",
    "version": "0.0.0",
    "description": "平台无关 Fetch 服务端应用模型（不绑 Node / Tokio / Cloudflare）",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/types": "workspace:*",
        "@wae/core": "workspace:*",
        "@wae/protocol": "workspace:*"
    },
    "devDependencies": {
        "typescript": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    }
}
