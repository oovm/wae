{
    "name": "@wae/server",
    "version": "0.1.0",
    "description": "平台无关 Fetch 服务端应用模型（不绑 Node / Tokio / Cloudflare）",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/types": "workspace:*",
        "@wae/core": "workspace:*",
        "@wae/protocol": "workspace:*"
    },
    "devDependencies": {
        "typescript": "catalog:"
    }
}
