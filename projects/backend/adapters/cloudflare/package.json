{
    "name": "@wae/server-cloudflare",
    "version": "0.0.0",
    "description": "Cloudflare Workers / Pages / Durable Objects 适配",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./durable-objects": {
            "types": "./dist/durable-objects.d.ts",
            "import": "./dist/durable-objects.js",
            "default": "./dist/durable-objects.js"
        },
        "./queues": {
            "types": "./dist/queues.d.ts",
            "import": "./dist/queues.js",
            "default": "./dist/queues.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@wae/server": "workspace:*",
        "@wae/serverless": "workspace:*"
    },
    "license": "MIT",
    "devDependencies": {
        "typescript": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    }
}
