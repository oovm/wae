{
    "name": "@wae/adapter-vanilla",
    "version": "0.1.0",
    "description": "最小适配：无 UI 框架项目、调试面板、协议验证；不可升级为自有 UI 框架",
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/client": "workspace:*"
    },
    "peerDependencies": {},
    "devDependencies": {
        "typescript": "catalog:"
    }
}
