{
    "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/node_modules",
            "!**/target",
            "!**/dist",
            "!**/documentation/dist",
            "!**/documentation/.vitepress",
            "!**/*.d.ts",
            "!**/*.js.map"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "lineEnding": "lf"
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },
    "javascript": {
        "formatter": {
            "indentStyle": "space",
            "indentWidth": 4
        }
    },
    "json": {
        "formatter": {
            "indentStyle": "space",
            "indentWidth": 4
        }
    },
    "html": {
        "formatter": {
            "enabled": true,
            "indentStyle": "space",
            "indentWidth": 2
        }
    },
    "overrides": [
        {
            "includes": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs", "**/*.cjs", "**/*.jsx"],
            "formatter": {
                "indentWidth": 4
            }
        },
        {
            "includes": ["**/*.json", "**/*.jsonc"],
            "formatter": {
                "indentWidth": 4
            }
        },
        {
            "includes": ["**/*.vue"],
            "formatter": {
                "indentWidth": 2
            },
            "html": {
                "formatter": {
                    "indentWidth": 2
                }
            }
        },
        {
            "includes": ["**/*.yaml", "**/*.yml"],
            "formatter": {
                "indentWidth": 2
            }
        }
    ]
}
